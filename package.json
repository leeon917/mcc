{
  "name": "@hileeon/mcc",
  "version": "0.1.9",
  "description": "My Claude Code - Multi-provider account and model switching for Claude Code",
  "license": "MIT",
  "author": "Leeon",
  "repository": "https://github.com/leeon917/mcc",
  "main": "dist/mcc.js",
  "types": "dist/mcc.d.ts",
  "bin": {
    "mcc": "dist/mcc.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "lib"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const p='dist/mcc.js';const c=fs.readFileSync(p,'utf8');if(!c.startsWith('#!')){fs.writeFileSync(p,'#!/usr/bin/env node\\n'+c);}\"",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "build:ui": "pnpm -C ui install && pnpm -C ui build",
    "build:all": "pnpm build && pnpm build:ui",
    "prepublishOnly": "pnpm build:all",
    "postversion": "git push --follow-tags",
    "mcc": "pnpm build && tsx src/mcc.ts",
    "dash": "tsx watch src/dashboard/server.ts",
    "ui": "pnpm -C ui dev",
    "dev": "concurrently -k -n be,fe -c blue,magenta \"pnpm dash\" \"pnpm ui\"",
    "dashboard": "pnpm build && pnpm build:ui && node dist/dashboard/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "picocolors": "^1.1.1",
    "update-notifier": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/update-notifier": "^6.0.8",
    "concurrently": "^10.0.3",
    "tsx": "^4.22.4",
    "typescript": "^5.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
